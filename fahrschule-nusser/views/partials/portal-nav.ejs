<%
  // Seitenleiste am Rechner. Auf dem Handy wird sie ausgeblendet -
  // dort übernimmt die Leiste am unteren Bildschirmrand.
  const punkte = nav.eintraege(currentUser);
%>
<nav class="portal-nav" aria-label="Portalnavigation">
  <div class="portal-nav-titel">
    <% if (currentUser.role === 'student') { %>Mein Bereich
    <% } else if (currentUser.role === 'instructor') { %>Fahrlehrer
    <% } else { %>Verwaltung<% } %>
  </div>

  <% punkte.forEach(function (punkt) { %>
    <a href="<%= punkt.href %>" class="<%= nav.istAktiv(punkt, currentPath) ? 'aktiv' : '' %>">
      <%= punkt.label %>
    </a>
  <% }); %>

  <div class="trenner"></div>
  <a href="/">Zur Website</a>
  <form method="post" action="/portal/abmelden">
    <button type="submit" class="btn btn-hell btn-klein btn-voll" style="margin-top: 6px">Abmelden</button>
  </form>
</nav>
