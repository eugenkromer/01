<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main id="inhalt" class="portal-layout">
  <%- include('../partials/portal-nav') %>

  <div class="portal-inhalt">
    <div class="portal-kopf">
      <div>
        <h1>Theorietermine</h1>
        <p>Termine anlegen und sehen, wer sich angemeldet hat.</p>
      </div>
    </div>

    <% if (hinweis) { %><div class="meldung meldung-erfolg"><p><%= hinweis %></p></div><% } %>
    <% if (fehler) { %><div class="meldung meldung-fehler"><p><%= fehler %></p></div><% } %>

    <div class="portal-block">
      <h2><%= bearbeiten ? 'Termin bearbeiten' : 'Neuen Termin anlegen' %></h2>

      <form class="formular" method="post"
            action="<%= bearbeiten ? '/portal/verwaltung/theorie/' + bearbeiten.id : '/portal/verwaltung/theorie' %>">

        <div class="feld-reihe">
          <div class="feld">
            <label class="feld-pflicht" for="startsAt">Beginn</label>
            <input type="datetime-local" id="startsAt" name="startsAt" required
                   value="<%= bearbeiten ? f.toInputValue(bearbeiten.startsAt) : '' %>">
          </div>
          <div class="feld">
            <label for="endsAt">Ende</label>
            <input type="datetime-local" id="endsAt" name="endsAt"
                   value="<%= bearbeiten && bearbeiten.endsAt ? f.toInputValue(bearbeiten.endsAt) : '' %>">
          </div>
        </div>

        <div class="feld-reihe">
          <div class="feld">
            <label for="locationId">Standort</label>
            <select id="locationId" name="locationId">
              <option value="">Nicht festgelegt</option>
              <% content.locations.forEach(function (ort) { %>
                <option value="<%= ort.id %>"
                  <%= bearbeiten && bearbeiten.locationId === ort.id ? 'selected' : '' %>>
                  <%= ort.name %>
                </option>
              <% }); %>
            </select>
          </div>
          <div class="feld">
            <label for="lessonNo">Pflichtlektion</label>
            <select id="lessonNo" name="lessonNo">
              <option value="">Keine / Sonderthema</option>
              <% content.theoryLessons.forEach(function (lektion) { %>
                <option value="<%= lektion.no %>"
                  <%= bearbeiten && bearbeiten.lessonNo === lektion.no ? 'selected' : '' %>>
                  <%= lektion.no %> – <%= lektion.title %>
                </option>
              <% }); %>
            </select>
          </div>
        </div>

        <div class="feld">
          <label for="topic">Thema</label>
          <input type="text" id="topic" name="topic" placeholder="z. B. Vorfahrt und Verkehrsregelungen"
                 value="<%= bearbeiten ? (bearbeiten.topic || '') : '' %>">
        </div>

        <div class="feld-reihe">
          <div class="feld">
            <label for="instructor">Fahrlehrer/in</label>
            <input type="text" id="instructor" name="instructor"
                   value="<%= bearbeiten ? (bearbeiten.instructor || '') : '' %>">
          </div>
          <div class="feld">
            <label for="capacity">Plätze</label>
            <input type="number" id="capacity" name="capacity" min="0" step="1"
                   value="<%= bearbeiten ? bearbeiten.capacity : 0 %>">
            <span class="hinweis">0 bedeutet: keine Begrenzung.</span>
          </div>
        </div>

        <div class="reihe">
          <button class="btn btn-primaer" type="submit">
            <%= bearbeiten ? 'Änderungen speichern' : 'Termin anlegen' %>
          </button>
          <% if (bearbeiten) { %>
            <a class="btn btn-hell" href="/portal/verwaltung/theorie">Abbrechen</a>
          <% } %>
        </div>
      </form>
    </div>

    <div class="portal-block">
      <h2>Alle Termine</h2>
      <% if (termine.length === 0) { %>
        <div class="leer">
          <div class="symbol" aria-hidden="true">📅</div>
          <p>Es sind noch keine Termine eingetragen.</p>
        </div>
      <% } else { %>
        <div class="tabelle-rahmen">
          <table>
            <thead>
              <tr><th>Termin</th><th>Thema</th><th>Standort</th><th>Anmeldungen</th><th></th></tr>
            </thead>
            <tbody>
              <% termine.forEach(function (t) { %>
                <tr <%= t.vergangen ? 'style="opacity: .55"' : '' %>>
                  <td class="nowrap">
                    <%= f.formatDateTime(t.startsAt) %>
                    <% if (t.vergangen) { %><br><span class="marker grau">vorbei</span><% } %>
                  </td>
                  <td>
                    <% if (t.lessonNo) { %><strong>Lektion <%= t.lessonNo %></strong><br><% } %>
                    <%= t.topic || '–' %>
                    <% if (t.instructor) { %><br><span class="klein mute"><%= t.instructor %></span><% } %>
                  </td>
                  <td><%= t.ortName || '–' %></td>
                  <td class="nowrap">
                    <%= t.belegt %><% if (t.capacity > 0) { %> / <%= t.capacity %><% } %>
                  </td>
                  <td>
                    <div class="reihe">
                      <a class="btn btn-hell btn-klein" href="/portal/verwaltung/theorie/<%= t.id %>/teilnehmer">Liste</a>
                      <a class="btn btn-hell btn-klein" href="/portal/verwaltung/theorie/<%= t.id %>/bearbeiten">Ändern</a>
                      <form method="post" action="/portal/verwaltung/theorie/<%= t.id %>/loeschen"
                            onsubmit="return confirm('Diesen Termin wirklich löschen? Bestehende Anmeldungen werden mit entfernt.')">
                        <button class="btn btn-gefahr btn-klein" type="submit">Löschen</button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
