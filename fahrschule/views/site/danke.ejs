<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main id="inhalt">
  <section>
    <div class="wrap narrow">
      <div class="karte zentriert" style="padding: clamp(32px, 6vw, 56px)">
        <div style="width: 66px; height: 66px; border-radius: 50%; background: var(--gruen-soft);
                    color: var(--gruen); display: grid; place-items: center; font-size: 2rem;
                    margin: 0 auto 22px">✓</div>
        <h1 style="font-size: clamp(1.7rem, 4vw, 2.3rem)"><%= ueberschrift %></h1>
        <p class="lead" style="margin: 0 auto 26px"><%= text %></p>

        <% if (!emailConfigured) { %>
          <div class="meldung meldung-warnung" style="text-align: left">
            <p><strong>Hinweis für die Fahrschule:</strong> Es ist noch kein E-Mail-Versand
              eingerichtet. Die Anfrage wurde gespeichert und ist im Verwaltungsbereich
              sichtbar, es wurde aber keine Benachrichtigung verschickt. Wie das eingerichtet
              wird, steht in der README.</p>
          </div>
        <% } %>

        <div class="reihe" style="justify-content: center">
          <a class="btn btn-dunkel" href="/">Zurück zur Startseite</a>
          <a class="btn btn-hell" href="/fuehrerschein">Führerscheinklassen ansehen</a>
        </div>
      </div>
    </div>
  </section>
</main>

<%- include('../partials/footer') %>
