<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main id="inhalt" class="portal-layout">
  <%- include('../partials/portal-nav') %>

  <div class="portal-inhalt">
    <div class="portal-kopf">
      <div>
        <h1>Hallo <%= currentUser.firstName %>!</h1>
        <p>Wähle einen Fahrschüler aus, um eine Fahrstunde einzutragen.</p>
      </div>
      <% if (meineHeute > 0) { %>
        <span class="marker gruen">Heute <%= meineHeute %> Fahrstunden eingetragen</span>
      <% } %>
    </div>

    <% if (hinweis) { %><div class="meldung meldung-erfolg"><p><%= hinweis %></p></div><% } %>
    <% if (fehler) { %><div class="meldung meldung-fehler"><p><%= fehler %></p></div><% } %>

    <div class="portal-block">
      <h2>Fahrschüler</h2>
      <p class="block-info">Namen antippen, um Fahrstunden einzutragen. Deine eigenen stehen
        oben – du kannst aber bei allen eintragen, etwa wenn du jemanden vertrittst.</p>

      <% if (studenten.length === 0) { %>
        <div class="leer">
          <div class="symbol" aria-hidden="true">👥</div>
          <p>Es ist noch kein Fahrschüler angelegt.</p>
        </div>
      <% } else { %>

        <div class="suchleiste">
          <label class="sr-nur" for="suche">Fahrschüler suchen</label>
          <input type="search" id="suche" placeholder="Namen suchen …"
                 autocomplete="off"
                 data-sucht-in="#schuelerliste"
                 data-leer-hinweis="#nichts-gefunden">
          <span class="suche-zaehler" data-suche-zaehler></span>
        </div>

        <div class="schueler-liste" id="schuelerliste">
          <% studenten.forEach(function (s) { %>
            <a class="schueler-karte" href="/portal/fahrlehrer/fahrschueler/<%= s.id %>"
               data-suche="<%= s.firstName %> <%= s.lastName %> <%= s.licenseClass %> <%= s.email %>">
              <div class="schueler-name">
                <strong><%= s.lastName %>, <%= s.firstName %></strong>
                <% if (s.meiner) { %><span class="marker blau">mein Fahrschüler</span><% } %>
              </div>

              <div class="schueler-werte">
                <span><span class="bez">Klasse</span><%= s.licenseClass %></span>
                <span><span class="bez">Übungsstunden</span><%= s.stand.fahrstunden %></span>
                <span><span class="bez">Sonderfahrten</span>
                  <%= s.stand.sonderGesamt.ist %> / <%= s.stand.sonderGesamt.soll %></span>
                <span><span class="bez">Letzte Fahrt</span>
                  <% if (s.letzteFahrstunde) { %>
                    <%= f.formatDateShort(s.letzteFahrstunde.date) %>
                  <% } else { %>–<% } %>
                </span>
              </div>

              <span class="pfeil" aria-hidden="true">›</span>
            </a>
          <% }); %>
        </div>

        <div class="leer" id="nichts-gefunden" hidden>
          <p>Kein Fahrschüler mit diesem Namen.</p>
        </div>
      <% } %>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
