# Diese Datei nach .env kopieren und ausfüllen:
#   cp .env.example .env

# Port, auf dem der Server lauscht
PORT=3000

# E-Mail-Adresse des ersten Verwaltungszugangs. Wird beim allerersten
# Start automatisch angelegt, solange noch kein Zugang existiert.
SEED_ADMIN_EMAIL=info@musterfahrschule.de

# Lange Zufallszeichenkette zum Signieren der Sitzungs-Cookies.
# Eine erzeugen mit:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=bitte-durch-eine-lange-zufallszeichenkette-ersetzen

# Öffentliche Adresse der Seite, ohne Schrägstrich am Ende. Daraus werden
# die Anmeldelinks in den E-Mails gebaut - im Betrieb unbedingt auf die
# echte Domain setzen, sonst zeigen die Links auf localhost.
BASE_URL=http://localhost:3000

# Ordner für die Daten. Lokal leer lassen - dann wird data/ im Projekt
# benutzt. Im Betrieb auf den dauerhaften Speicher zeigen lassen (bei
# Render z. B. /var/data), sonst gehen bei jeder neuen Veröffentlichung
# alle Fahrschüler, Termine und Anfragen verloren.
DATA_DIR=

# Auf "production" setzen, sobald die Seite hinter HTTPS läuft. Dann wird
# das Sitzungs-Cookie nur noch über verschlüsselte Verbindungen gesendet.
NODE_ENV=development

# Vorführmodus. Auf "true" setzen, um die Seite mit Beispieldaten
# vorzuführen: Auf der Anmeldeseite stehen dann alle Zugänge zum
# Anklicken, sodass man das Portal auch ohne eingerichteten E-Mail-Versand
# betreten kann, und oben läuft ein Hinweisband.
# ACHTUNG: Im echten Betrieb leer lassen - sonst käme jeder Besucher in
# jedes Konto, auch in die Verwaltung.
DEMO_MODE=

# --- E-Mail-Versand ---
# Nötig, damit Anmeldelinks und Benachrichtigungen wirklich verschickt
# werden. Solange nichts eingetragen ist, landen alle E-Mails nur in der
# Konsole und in data/outbox.log - praktisch zum Ausprobieren.

# Weg A (empfohlen): Resend, verschickt über normales HTTPS.
# Viele Hosting-Anbieter sperren ausgehende SMTP-Ports (25/465/587),
# lassen HTTPS aber immer durch.
#   1. Bei https://resend.com registrieren (kostenlos, 100 E-Mails/Tag)
#   2. Unter "Domains" die eigene Domain eintragen und die angezeigten
#      DNS-Einträge beim Domain-Anbieter hinterlegen
#   3. Unter "API Keys" einen Schlüssel erzeugen und hier einsetzen
RESEND_API_KEY=
RESEND_FROM="Fahrschule <no-reply@deine-domain.de>"

# Weg B: klassisches SMTP. Funktioniert auf einem eigenen Server oder VPS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Fahrschule <no-reply@deine-domain.de>"
