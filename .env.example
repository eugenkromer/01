# Copy this file to .env and fill in real values before going live.

# Port the server listens on
PORT=3000

# Email of the first admin account, created automatically the first time
# the server runs (only used if no users exist yet).
SEED_ADMIN_EMAIL=eugenkromer@hv-manager.de

# Random long string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-string

# Public base URL of the site (no trailing slash). Used to build links in
# emails (login links, admin handover links). Set this to your real domain
# once the site is deployed, e.g. https://www.example-wedding-rentals.com
BASE_URL=http://localhost:3000

# --- Outgoing email ---
# Required to actually deliver login links and request notifications.
# Until one of the two options below is set, emails are only logged to the
# console and to data/outbox.log so you can still test the whole flow
# locally. If both are set, Resend is used.

# Option A (recommended): Resend, over plain HTTPS.
# Many hosting platforms (Render's free tier included) block outbound SMTP
# ports (25/465/587) but never block HTTPS, so an HTTP-based provider like
# Resend is the most reliable choice once this app is deployed somewhere
# other than your own machine or a VPS with unrestricted outbound access.
#   1. Sign up at https://resend.com (free tier: 100 emails/day)
#   2. Verify your own domain there (Domains -> Add Domain) by adding the
#      DNS records it gives you at your domain's DNS provider (e.g. Strato)
#   3. Create an API key (API Keys -> Create API Key) and paste it below
RESEND_API_KEY=
RESEND_FROM="Wedding Rentals <no-reply@yourdomain.com>"

# Option B: direct SMTP. Works from your own machine or a VPS; on many
# PaaS platforms the connection will just time out (blocked outbound port).
#
# Example using a Gmail account with an "app password":
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=youraddress@gmail.com
#   SMTP_PASS=your-16-character-app-password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# "From" address used for SMTP sends (Option B only - Option A uses
# RESEND_FROM above)
SMTP_FROM="Wedding Rentals <no-reply@example.com>"
