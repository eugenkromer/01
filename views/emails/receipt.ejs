<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Receipt</title>
</head>
<body style="margin:0; padding:0; background:#f7ece4; font-family:Georgia, 'Times New Roman', serif; color:#3d2f2c;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f7ece4; padding:32px 16px;">
    <tr>
      <td align="center">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px; background:#ffffff; border-radius:8px; overflow:hidden; border:1px solid #e7d9b8;">

          <tr>
            <td style="background:#3d2f2c; padding:28px 32px;">
              <span style="font-size:20px; color:#fdf8f4; font-weight:bold;">[COMPANY NAME]</span><br>
              <span style="font-size:13px; color:#e7d9b8; letter-spacing:.05em; text-transform:uppercase;">Order Receipt</span>
            </td>
          </tr>

          <tr>
            <td style="padding:28px 32px 0;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="font-size:14px;">
                <tr>
                  <td style="color:#6b5a55; padding-bottom:4px;">Order #</td>
                  <td align="right" style="color:#3d2f2c; padding-bottom:4px;"><%= orderNumber %></td>
                </tr>
                <tr>
                  <td style="color:#6b5a55; padding-bottom:4px;">Confirmed</td>
                  <td align="right" style="color:#3d2f2c; padding-bottom:4px;"><%= confirmedDate %></td>
                </tr>
                <tr>
                  <td style="color:#6b5a55; padding-bottom:4px;">Event</td>
                  <td align="right" style="color:#3d2f2c; padding-bottom:4px;"><%= request.eventType %><% if (request.eventDate) { %> &middot; <%= request.eventDate %><% } %></td>
                </tr>
                <tr>
                  <td style="color:#6b5a55;">Billed to</td>
                  <td align="right" style="color:#3d2f2c;"><%= request.customerName %><br><span style="font-size:12px; color:#6b5a55;"><%= request.customerEmail %></span></td>
                </tr>
              </table>
            </td>
          </tr>

          <tr>
            <td style="padding:24px 32px 0;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="font-size:14px; border-collapse:collapse;">
                <tr>
                  <th align="left" style="border-bottom:2px solid #3d2f2c; padding:8px 0; font-size:12px; text-transform:uppercase; letter-spacing:.04em; color:#6b5a55;">Item</th>
                  <th align="center" style="border-bottom:2px solid #3d2f2c; padding:8px 0; font-size:12px; text-transform:uppercase; letter-spacing:.04em; color:#6b5a55;">Qty</th>
                  <th align="right" style="border-bottom:2px solid #3d2f2c; padding:8px 0; font-size:12px; text-transform:uppercase; letter-spacing:.04em; color:#6b5a55;">Unit</th>
                  <th align="right" style="border-bottom:2px solid #3d2f2c; padding:8px 0; font-size:12px; text-transform:uppercase; letter-spacing:.04em; color:#6b5a55;">Total</th>
                </tr>
                <% request.items.forEach(function(i) { %>
                <tr>
                  <td style="border-bottom:1px solid #e7d9b8; padding:8px 0;"><%= i.name %></td>
                  <td align="center" style="border-bottom:1px solid #e7d9b8; padding:8px 0;"><%= i.qty %></td>
                  <td align="right" style="border-bottom:1px solid #e7d9b8; padding:8px 0;">$<%= i.price.toFixed(2) %></td>
                  <td align="right" style="border-bottom:1px solid #e7d9b8; padding:8px 0;">$<%= (i.price * i.qty).toFixed(2) %></td>
                </tr>
                <% }) %>
              </table>
            </td>
          </tr>

          <tr>
            <td style="padding:16px 32px 0;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="font-size:14px;">
                <tr>
                  <td style="color:#6b5a55; padding:3px 0;">Subtotal</td>
                  <td align="right" style="color:#3d2f2c; padding:3px 0;">$<%= request.itemsTotal.toFixed(2) %></td>
                </tr>
                <% if (request.cleaningFee) { %>
                <tr>
                  <td style="color:#6b5a55; padding:3px 0;">Cleaning fee</td>
                  <td align="right" style="color:#3d2f2c; padding:3px 0;">$<%= request.cleaningFee.toFixed(2) %></td>
                </tr>
                <% } %>
                <% if (request.deliveryFee) { %>
                <tr>
                  <td style="color:#6b5a55; padding:3px 0;">Delivery fee</td>
                  <td align="right" style="color:#3d2f2c; padding:3px 0;">$<%= request.deliveryFee.toFixed(2) %></td>
                </tr>
                <% } %>
                <tr>
                  <td style="border-top:2px solid #3d2f2c; color:#3d2f2c; font-weight:bold; padding:10px 0 0; font-size:16px;">Total</td>
                  <td align="right" style="border-top:2px solid #3d2f2c; color:#3d2f2c; font-weight:bold; padding:10px 0 0; font-size:16px;">$<%= request.total.toFixed(2) %></td>
                </tr>
              </table>
            </td>
          </tr>

          <% if (request.message) { %>
          <tr>
            <td style="padding:24px 32px 0;">
              <p style="margin:0; font-size:12px; text-transform:uppercase; letter-spacing:.04em; color:#6b5a55;">Your note</p>
              <p style="margin:4px 0 0; font-size:14px; color:#3d2f2c; font-style:italic;">"<%= request.message %>"</p>
            </td>
          </tr>
          <% } %>

          <tr>
            <td style="padding:28px 32px 32px;">
              <p style="margin:0 0 8px; font-size:14px; color:#3d2f2c;">Thank you for your order! We look forward to being part of your <%= request.eventType.toLowerCase() %>.</p>
              <p style="margin:0; font-size:13px; color:#6b5a55;">Questions about this order? Just reply to this email, or reach us at [EMAIL ADDRESS] / [PHONE NUMBER].</p>
            </td>
          </tr>

          <tr>
            <td style="background:#f7ece4; padding:16px 32px; text-align:center;">
              <p style="margin:0; font-size:12px; color:#6b5a55;">[COMPANY NAME] &middot; [STREET ADDRESS, CITY, STATE ZIP]</p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
