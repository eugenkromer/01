<!DOCTYPE html>
<html lang="en">
<head>
<%- include('../partials/admin-head') %>
</head>
<body class="admin-body">
<header class="admin-topbar">
  <div class="admin-topbar-inner">
    <span class="admin-brand">[COMPANY NAME] <em>Admin</em></span>
  </div>
</header>

<main class="admin-main admin-main-narrow">
  <a href="/admin#catalog" class="admin-back-link">&larr; Back to catalog</a>
  <h1><%= item && item.id ? 'Edit Item' : 'Add Item' %></h1>

  <% if (error) { %><p class="admin-notice admin-notice-error"><%= error %></p><% } %>

  <form method="POST" action="<%= item && item.id ? `/admin/items/${item.id}/update` : '/admin/items' %>" class="admin-form" enctype="multipart/form-data">
    <div class="form-row">
      <label for="name">Item name*</label>
      <input type="text" id="name" name="name" required value="<%= item ? item.name || '' : '' %>" placeholder="e.g. 60&quot; Round Table">
    </div>
    <div class="form-row">
      <label for="category">Category*</label>
      <input type="text" id="category" name="category" required value="<%= item ? item.category || '' : '' %>" placeholder="e.g. Tables, Chairs, Decor, Tableware">
    </div>
    <div class="form-row">
      <label for="dimensions">Dimensions</label>
      <input type="text" id="dimensions" name="dimensions" value="<%= item ? item.dimensions || '' : '' %>" placeholder="e.g. 60 in diameter">
    </div>
    <div class="form-row">
      <label for="description">Description</label>
      <textarea id="description" name="description" rows="3" placeholder="A short description customers will see"><%= item ? item.description || '' : '' %></textarea>
    </div>
    <div class="form-row form-row-third">
      <div>
        <label for="price">Price (USD)*</label>
        <input type="number" id="price" name="price" required min="0" step="0.01" value="<%= item ? item.price || '' : '' %>">
      </div>
      <div>
        <label for="priceUnit">Price unit</label>
        <input type="text" id="priceUnit" name="priceUnit" value="<%= item ? item.priceUnit || 'each' : 'each' %>" placeholder="each, per event, per set...">
      </div>
      <div>
        <label for="stock">Quantity in stock*</label>
        <input type="number" id="stock" name="stock" required min="0" step="1" value="<%= item ? item.stock || 0 : 0 %>">
      </div>
    </div>
    <div class="form-row">
      <label for="photo">Photo</label>
      <% if (item && item.imageUrl) { %>
        <img src="<%= item.imageUrl %>" alt="" class="admin-photo-preview">
      <% } %>
      <input type="file" id="photo" name="photo" accept="image/*">
      <p class="field-hint">JPG, PNG, GIF or WebP, up to 5 MB.<% if (item && item.imageUrl) { %> Leave empty to keep the current photo.<% } %></p>
    </div>
    <div class="form-row">
      <label for="imageUrl">...or a photo URL instead</label>
      <input type="url" id="imageUrl" name="imageUrl" value="<%= item && item.imageUrl && item.imageUrl.startsWith('http') ? item.imageUrl : '' %>" placeholder="https://...">
      <p class="field-hint">Only used if no file is uploaded above.</p>
    </div>
    <button type="submit" class="btn btn-primary btn-large"><%= item && item.id ? 'Save Changes' : 'Add Item' %></button>
  </form>
</main>
</body>
</html>
